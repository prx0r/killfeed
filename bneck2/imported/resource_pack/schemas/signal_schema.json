{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGI Bottleneck Signal",
  "type": "object",
  "required": [
    "id",
    "observed_at",
    "source_type",
    "source_uri",
    "claim",
    "evidence_tier"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_type": {
      "enum": [
        "equity",
        "options",
        "prediction_market",
        "expert",
        "github",
        "huggingface",
        "benchmark",
        "paper",
        "patent",
        "filing",
        "government",
        "trade",
        "energy",
        "jobs",
        "news",
        "other"
      ]
    },
    "source_uri": {
      "type": "string"
    },
    "entity": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_node": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_edge": {
      "type": [
        "string",
        "null"
      ]
    },
    "claim": {
      "type": "string"
    },
    "polarity": {
      "enum": [
        "binds",
        "relieves",
        "kills",
        "supports",
        "neutral",
        "unknown"
      ]
    },
    "evidence_tier": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "origin_claim_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independence_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "author_topic_skill": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "market_probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "raw_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}